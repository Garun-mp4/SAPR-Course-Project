{
  "device_id": "sapr-room-01",
  "board": "Espressif ESP32-DevKitC V4 / WROOM-32E",
  "sensor": "Adafruit 5190 / Sensirion SCD41",
  "fan": "Noctua NF-A8 FLX, 12 V, 3-pin",
  "switch": "Pololu Mini MOSFET Slide Switch LV #2810",
  "i2c": {"sda": 21, "scl": 22, "frequency_hz": 100000, "address": 98},
  "exhaust": {"enable": 25, "tach": 36, "pulses_per_revolution": 2},
  "policy": {
    "on_ppm": 1000, "off_below_ppm": 800,
    "minimum_run_ms": 300000, "sample_period_ms": 5000,
    "stale_ms": 15000, "tach_timeout_ms": 5000
  },
  "enclosure_mm": {
    "length": 115, "width": 80, "base_height": 30,
    "wall": 3, "floor": 3, "lid_thickness": 3
  }
}
